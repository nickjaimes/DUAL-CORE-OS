    def __init__(self, version="2.0.0", build_dir="build", dist_dir="dist"):
        self.version = version
        self.build_dir = Path(build_dir)
        self.dist_dir = Path(dist_dir)
        self.artifacts = []
        
        # Create directories
        self.build_dir.mkdir(exist_ok=True, parents=True)
        self.dist_dir.mkdir(exist_ok=True, parents=True)
        
    def build_all(self):
        """Build all platform installers"""
        print(f"Building Dual Core OS v{self.version}")
        print("=" * 50)
        
        platforms = [
            ('linux', ['deb', 'rpm', 'tar.gz', 'appimage']),
            ('macos', ['dmg', 'pkg']),
            ('windows', ['exe', 'msi']),
            ('android', ['apk']),
            ('ios', ['ipa']),
            ('cloud', ['docker', 'vm']),
            ('universal', ['container'])
        ]
        
        for platform, formats in platforms:
            print(f"\nBuilding for {platform}:")
            for format_type in formats:
                try:
                    installer = self.build_platform(platform, format_type)
                    self.artifacts.append(installer)
                    print(f"  ✓ {format_type}")
                except Exception as e:
                    print(f"  ✗ {format_type}: {e}")
        
        # Generate installation manifests
        self.generate_manifests()
        
        print(f"\nBuild complete! Artifacts in: {self.dist_dir}")
        return self.artifacts
    
    def build_platform(self, platform: str, format_type: str) -> Dict:
        """Build installer for specific platform and format"""
        platform_dir = self.build_dir / platform / format_type
        platform_dir.mkdir(parents=True, exist_ok=True)
        
        # Platform-specific build methods
        build_methods = {
            'linux': {
                'deb': self.build_deb,
                'rpm': self.build_rpm,
                'tar.gz': self.build_tar,
                'appimage': self.build_appimage
            },
            'macos': {
                'dmg': self.build_dmg,
                'pkg': self.build_pkg
            },
            'windows': {
                'exe': self.build_exe,
                'msi': self.build_msi
            },
            'android': {
                'apk': self.build_apk
            },
            'ios': {
                'ipa': self.build_ipa
            },
            'cloud': {
                'docker': self.build_docker,
                'vm': self.build_vm
            },
            'universal': {
                'container': self.build_container
            }
        }
        
        if platform not in build_methods or format_type not in build_methods[platform]:
            raise ValueError(f"Unsupported platform/format: {platform}/{format_type}")
        
        # Build the installer
