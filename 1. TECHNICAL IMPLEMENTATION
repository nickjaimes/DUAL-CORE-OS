```bash
#!/bin/bash
# install.sh - Universal Dual Core OS Installer

PLATFORMS="linux macos windows"
QUANTUM_HARDWARE="ibm_sherbrooke"

detect_platform() {
    case "$(uname -s)" in
        Linux*)     echo "linux" ;;
        Darwin*)    echo "macos" ;;
        CYGWIN*|MINGW*|MSYS*) echo "windows" ;;
        *)          echo "unknown" ;;
    esac
}

install_dualcore() {
    local platform=$1
    
    echo "Installing Dual Core OS on $platform..."
    
    case $platform in
        linux)
            # Linux installation
            cp dualcore.kernel /boot/dualcore-$(uname -r)
            update-grub2
            systemctl enable dualcore.service
            ;;
            
        macos)
            # macOS installation
            sudo cp dualcore.kext /Library/Extensions/
            sudo kextload /Library/Extensions/dualcore.kext
            sudo nvram boot-args="dualcore=1"
            ;;
            
        windows)
            # Windows installation
            reg add "HKLM\SYSTEM\CurrentControlSet\Services\DualCore" \
                /v "ImagePath" /t REG_EXPAND_SZ \
                /d "%SystemRoot%\system32\drivers\dualcore.sys" /f
            sc start DualCore
            ;;
    esac
    
    # Install quantum components
    if [ -f "/sys/class/quantum/available" ]; then
        install_quantum_drivers $QUANTUM_HARDWARE
    fi
    
    echo "Installation complete!"
}

# Main installation
main() {
    local target_platform=${1:-$(detect_platform)}
    
    if [[ ! " $PLATFORMS " =~ " $target_platform " ]]; then
        echo "Unsupported platform: $target_platform"
        exit 1
    fi
    
    install_dualcore $target_platform
}

main "$@"
