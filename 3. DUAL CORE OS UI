    <script>
        // Initialize Quantum Interface
        document.addEventListener('DOMContentLoaded', function() {
            initializeQuantumInterface();
            createQuantumParticles();
            startSystemUpdates();
        });
        
        function initializeQuantumInterface() {
            // Update time display
            updateTime();
            setInterval(updateTime, 1000);
            
            // Initialize qubit grid
            initializeQubitGrid();
            
            // Setup app icons
            setupAppIcons();
            
            // Setup start menu
            document.getElementById('startMenu').addEventListener('click', showStartMenu);
            
            // Initial notifications
            showNotification('System Initialized', 'Dual Core OS v2.0 Quantum Alpha is now active');
            showNotification('Trinity AI Online', 'Analytical, Emotional, and Creative cores synchronized');
            showNotification('Quantum Processor', '128 qubits calibrated and ready');
        }
        
        function createQuantumParticles() {
            const particlesContainer = document.getElementById('particles');
            for (let i = 0; i < 50; i++) {
                const particle = document.createElement('div');
                particle.classList.add('particle');
                
                // Random properties
                const size = Math.random() * 4 + 1;
                const x = Math.random() * 100;
                const y = Math.random() * 100;
                const duration = Math.random() * 30 + 20;
                const delay = Math.random() * 5;
                const color = getRandomQuantumColor();
                
                particle.style.width = `${size}px`;
                particle.style.height = `${size}px`;
                particle.style.left = `${x}%`;
                particle.style.top = `${y}%`;
                particle.style.background = color;
                particle.style.animationDuration = `${duration}s`;
                particle.style.animationDelay = `${delay}s`;
                
                particlesContainer.appendChild(particle);
            }
        }
        
        function getRandomQuantumColor() {
            const colors = [
                'var(--quantum-cyan)',
                'var(--quantum-blue)',
                'var(--quantum-pink)',
                'var(--quantum-green)',
                'var(--quantum-yellow)'
            ];
            return colors[Math.floor(Math.random() * colors.length)];
        }
        
        function updateTime() {
            const now = new Date();
            const timeString = now.toLocaleTimeString('en-US', { 
                hour12: false,
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit'
            });
            document.getElementById('timeDisplay').textContent = timeString;
        }
        
        function initializeQubitGrid() {
            const grid = document.getElementById('qubitGrid');
            for (let i = 0; i < 64; i++) { // 8x8 grid
                const qubit = document.createElement('div');
                qubit.classList.add('qubit');
                qubit.textContent = i + 1;
                
                // Randomly activate some qubits
                if (Math.random() > 0.5) {
                    qubit.classList.add('active');
                }
                
                // Make qubits pulse randomly
                setInterval(() => {
                    if (Math.random() > 0.7) {
                        qubit.classList.toggle('active');
                    }
                }, Math.random() * 3000 + 1000);
                
                grid.appendChild(qubit);
            }
        }
        
        function setupAppIcons() {
            const appIcons = document.querySelectorAll('.app-icon');
            appIcons.forEach(icon => {
                icon.addEventListener('click', function() {
                    // Remove active class from all icons
                    appIcons.forEach(i => i.classList.remove('active'));
                    // Add active class to clicked icon
                    this.classList.add('active');
                    
                    const app = this.dataset.app;
                    launchApplication(app);
                });
            });
        }
        
        function launchApplication(app) {
            showNotification('Application Launch', `Starting ${app.replace('-', ' ')}...`);
            
            switch(app) {
                case 'quantum-terminal':
                    // Focus terminal
                    document.getElementById('quantumTerminal').scrollIntoView({ behavior: 'smooth' });
                    break;
                case 'trinity-ai':
                    showNotification('Trinity AI', 'Engaging all intelligence cores');
                    // Simulate AI processing
                    simulateAIProcessing();
                    break;
                case 'quantum-lab':
                    showNotification('Quantum Lab', 'Opening quantum circuit designer');
                    break;
                case 'eagle-eye':
                    showNotification('Eagle Eye', 'Activating system surveillance');
                    break;
            }
        }
        
        function showStartMenu() {
            showNotification('Dual Core OS', 'Access system controls, applications, and settings');
            
            // Create start menu
            const menu = document.createElement('div');
            menu.style.cssText = `
                position: fixed;
                bottom: 60px;
                left: 20px;
                width: 300px;
                background: rgba(18, 24, 43, 0.95);
                backdrop-filter: blur(20px);
                border: 1px solid rgba(138, 43, 226, 0.3);
                border-radius: 12px;
                padding: 15px;
                z-index: 1001;
                box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
            `;
            
            menu.innerHTML = `
                <div style="margin-bottom: 15px;">
                    <div style="color: var(--quantum-cyan); font-weight: bold; margin-bottom: 10px;">⚡ Dual Core OS</div>
                    <div style="font-size: 12px; color: rgba(255, 255, 255, 0.7);">v2.0 Quantum Alpha</div>
                </div>
                <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 15px;">
                    <div class="start-menu-item" onclick="launchApplication('quantum-terminal')">
                        <div style="font-size: 24px;">💻</div>
                        <div style="font-size: 11px;">Terminal</div>
                    </div>
                    <div class="start-menu-item" onclick="launchApplication('file-manager')">
                        <div style="font-size: 24px;">📁</div>
                        <div style="font-size: 11px;">Files</div>
                    </div>
                    <div class="start-menu-item" onclick="launchApplication('trinity-ai')">
                        <div style="font-size: 24px;">🧠</div>
                        <div style="font-size: 11px;">AI</div>
                    </div>
                </div>
                <div style="border-top: 1px solid rgba(255, 255, 255, 0.1); padding-top: 10px;">
                    <div class="start-menu-item" style="display: flex; align-items: center; gap: 10px; padding: 8px; border-radius: 8px; cursor: pointer;">
                        <div>⚙️</div>
                        <div>System Settings</div>
                    </div>
                    <div class="start-menu-item" style="display: flex; align-items: center; gap: 10px; padding: 8px; border-radius: 8px; cursor: pointer;">
                        <div>🔄</div>
                        <div>Smart Adapt</div>
                    </div>
                    <div class="start-menu-item" style="display: flex; align-items: center; gap: 10px; padding: 8px; border-radius: 8px; cursor: pointer; color: var(--quantum-danger);">
                        <div>⏻</div>
                        <div>Shutdown</div>
                    </div>
                </div>
            `;
            
            document.body.appendChild(menu);
            
            // Add styles for menu items
            const style = document.createElement('style');
            style.textContent = `
                .start-menu-item {
                    padding: 10px;
                    border-radius: 8px;
                    text-align: center;
                    cursor: pointer;
                    transition: all 0.2s ease;
                }
                .start-menu-item:hover {
                    background: rgba(138, 43, 226, 0.2);
                }
            `;
            document.head.appendChild(style);
            
            // Remove menu when clicking elsewhere
            setTimeout(() => {
                document.addEventListener('click', function closeMenu(e) {
                    if (!menu.contains(e.target) && e.target.id !== 'startMenu') {
                        menu.remove();
                        document.removeEventListener('click', closeMenu);
                    }
                });
            }, 100);
        }
        
        function showNotification(title, message) {
            const notificationCenter = document.getElementById('notificationCenter');
            const notification = document.createElement('div');
            notification.className = 'notification';
            notification.innerHTML = `
                <div class="notification-title">${title}</div>
                <div class="notification-message">${message}</div>
            `;
            
            notificationCenter.appendChild(notification);
            
            // Remove after 5 seconds
            setTimeout(() => {
                notification.style.animation = 'slideIn 0.3s ease reverse';
                setTimeout(() => notification.remove(), 300);
            }, 5000);
        }
        
        function simulateAIProcessing() {
            const cores = document.querySelectorAll('.core');
            cores.forEach(core => {
                const percentage = core.querySelector('.core-percentage');
                let value = parseInt(percentage.textContent);
                
                // Simulate AI learning
                const interval = setInterval(() => {
                    if (value < 100) {
                        value += Math.random() * 2;
                        percentage.textContent = value.toFixed(1) + '%';
                        
                        // Update status
                        const status = core.querySelector('.core-status');
                        if (value > 95) {
                            status.textContent = 'Optimal';
                            status.style.color = 'var(--quantum-success)';
                        } else if (value > 85) {
                            status.textContent = 'Learning';
                            status.style.color = 'var(--quantum-yellow)';
                        }
                    } else {
                        clearInterval(interval);
                    }
                }, 500);
            });
        }
        
        function startSystemUpdates() {
            // Update elemental balance randomly
            setInterval(() => {
                const segments = document.querySelectorAll('.element-segment');
                let total = 0;
                
                segments.forEach(segment => {
                    const change = (Math.random() - 0.5) * 2;
                    const currentWidth = parseFloat(segment.style.width);
                    const newWidth = Math.max(5, Math.min(35, currentWidth + change));
                    segment.style.width = `${newWidth}%`;
                    total += newWidth;
                });
                
                // Normalize to 100%
                const scale = 100 / total;
                segments.forEach(segment => {
                    const currentWidth = parseFloat(segment.style.width);
                    segment.style.width = `${currentWidth * scale}%`;
                });
            }, 3000);
            
            // Update process CPU usage
            setInterval(() => {
                const processBars = document.querySelectorAll('.process-cpu-bar');
                processBars.forEach(bar => {
                    const currentWidth = parseFloat(bar.style.width);
                    const change = (Math.random() - 0.5) * 20;
                    const newWidth = Math.max(5, Math.min(95, currentWidth + change));
                    bar.style.width = `${newWidth}%`;
                });
            }, 2000);
            
            // Add terminal output
            const terminal = document.getElementById('quantumTerminal');
            const commands = [
                'quantum optimize --elemental-balance',
                'trinity analyze --emotional-context',
                'eagle-eye monitor --predictive',
                'smart-connect --protocol=quantum',
                'fusion-core --boost=2.3x',
                'quantum-entangle --qubits=64'
            ];
            
            let commandIndex = 0;
            setInterval(() => {
                if (Math.random() > 0.7 && commandIndex < commands.length) {
                    const line = document.createElement('div');
                    line.className = 'terminal-line';
                    line.innerHTML = `<span class="terminal-prompt">quantum@dualcore:~$</span> ${commands[commandIndex]}`;
                    terminal.appendChild(line);
                    terminal.scrollTop = terminal.scrollHeight;
                    commandIndex++;
                }
            }, 3000);
        }
        
        // Make functions available globally for menu items
        window.launchApplication = launchApplication;
    </script>
</body>
</html>
